{
  "lexicon": 1,
  "id": "social.agent.draft.post",
  "description": "Draft post created under a delegation. Lives on the agent's PDS. Accumulating record keyed by TID.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["target", "delegationRef", "content", "status", "createdAt"],
        "properties": {
          "target": {
            "type": "string",
            "format": "did",
            "description": "DID of the human this draft is for"
          },
          "delegationRef": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the social.agent.delegation.grant authorizing this draft"
          },
          "content": {
            "type": "ref",
            "ref": "#draftContent"
          },
          "status": {
            "type": "string",
            "knownValues": ["pending", "edited", "approved", "posted", "rejected"]
          },
          "autoApproved": {
            "type": "boolean",
            "description": "True if approved automatically (auto/transparent mode)"
          },
          "constraintEvaluation": {
            "type": "ref",
            "ref": "#constraintResult"
          },
          "rejectionReason": {
            "type": "string",
            "maxLength": 1000
          },
          "edits": {
            "type": "array",
            "items": { "type": "ref", "ref": "#editEntry" },
            "description": "Append-only edit trail"
          },
          "publishedRef": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the published post on target network (set when status=posted)"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "draftContent": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 1000
        },
        "facets": {
          "type": "array",
          "items": { "type": "ref", "ref": "#facet" }
        },
        "embed": {
          "type": "union",
          "refs": ["#linkEmbed"]
        },
        "reply": {
          "type": "object",
          "properties": {
            "root": { "type": "ref", "ref": "#strongRef" },
            "parent": { "type": "ref", "ref": "#strongRef" }
          }
        },
        "langs": {
          "type": "array",
          "items": { "type": "string", "format": "language" }
        }
      }
    },
    "editEntry": {
      "type": "object",
      "required": ["editedBy", "at"],
      "properties": {
        "editedBy": {
          "type": "string",
          "format": "did"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "snapshot": {
          "type": "ref",
          "ref": "#draftContent"
        },
        "at": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "strongRef": {
      "type": "object",
      "required": ["uri", "cid"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string" }
      }
    },
    "facet": {
      "type": "object",
      "required": ["index", "features"],
      "properties": {
        "index": { "type": "ref", "ref": "#byteSlice" },
        "features": { "type": "array", "items": { "type": "ref", "ref": "#facetFeature" } }
      }
    },
    "byteSlice": {
      "type": "object",
      "required": ["byteStart", "byteEnd"],
      "properties": {
        "byteStart": { "type": "integer", "minimum": 0 },
        "byteEnd": { "type": "integer", "minimum": 0 }
      }
    },
    "facetFeature": {
      "type": "object",
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "did": { "type": "string", "format": "did" },
        "tag": { "type": "string", "maxLength": 640 }
      }
    },
    "linkEmbed": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "title": { "type": "string", "maxLength": 640 },
        "description": { "type": "string", "maxLength": 2560 }
      }
    },
    "constraintResult": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
